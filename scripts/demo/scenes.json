{
 "title": "iics - Informatica Cloud CLI",
 "width": 140,
 "height": 34,
 "env": {
  "IICS_PROFILE": "tst"
 },
 "scenes": [
  {
   "comment": "one profile per org; passwords stay in the OS keychain"
  },
  {
   "cmd": "iics profile list"
  },
  {
   "comment": "browse assets"
  },
  {
   "cmd": "iics objects list --type Project --limit 8"
  },
  {
   "comment": "secure agents and the services they run"
  },
  {
   "cmd": "iics agent list"
  },
  {
   "cmd": "iics agent details --name CAI-A03 --services",
   "pause": 3.5
  },
  {
   "comment": "service properties of a single agent, not only group defaults"
  },
  {
   "cmd": "iics agent configs get --name CAI-A03 --service 'Process Server' --type jvm",
   "pause": 3
  },
  {
   "cmd": "iics agent configs set --name CAI-A03 --set \"process-engine:jvm:max-heap='12G'\" --dry-run",
   "pause": 3
  },
  {
   "comment": "JSON output for scripts and pipelines"
  },
  {
   "cmd": "iics agent list -o json | jq -r '.[] | [.name, .agentHost, .agentVersion] | @tsv' | column -t"
  },
  {
   "comment": "interactive property editor (changes are reviewed before saving)"
  },
  {
   "cmd": "iics agent configs edit --name CAI-A03",
