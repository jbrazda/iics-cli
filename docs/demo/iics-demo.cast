[106.1335, "o", "\u001b[H\n\n\n\n  Switch profile\u001b[K\r\n\u001b[1;7m> Set as default profile \u270e\u001b[0m\u001b[K\r\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\u001b[38;5;252mMake the active profile the default in ~/.iics/config.yaml\u001b[0m\u001b[K\r\n\n\u001b[34;H"]
[106.6477, "o", "\u001b[H\n\n\n\n\n  Set as default profile \u270e\u001b[K\r\n\u001b[1;7m> Login\u001b[0m\u001b[K\r\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\u001b[38;5;252mSign in and refresh the session for the active profile\u001b[0m\u001b[K\r\n\u001b[3;38;5;244m$ iics login --profile tst\u001b[0m\u001b[K\r\n\u001b[34;H"]
[107.1584, "o", "\u001b[H\n\n\n\n\n\n  Login\u001b[K\r\n\u001b[1;7m> List profiles\u001b[0m\u001b[K\r\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\u001b[38;5;252mShow configured profiles\u001b[0m\u001b[K\r\n\u001b[3;38;5;244m$ iics profile list\u001b[0m\u001b[K\r\n\u001b[34;H"]
