[108.3289, "o", "\u001b[H\u001b[1;36miics\u001b[0m  \u001b[38;5;244mmain menu\u001b[0m   /a\u001b[7m \u001b[0m\u001b[K\r\n\n\n\n\n\n\n\u001b[1;7m> Add profile \u270e\u001b[0m\u001b[K\r\n  Edit active profile \u270e\u001b[K\r\n  Delete profile \u270e\u001b[K\r\n  Edit global settings\u001b[K\r\n\u001b[1;34mUsers\u001b[0m\u001b[K\r\n  List users\u001b[K\r\n  Show user\u001b[K\r\n  Create user \u270e\u001b[K\r\n  Edit user groups and roles \u270e\u001b[K\r\n  Delete user \u270e\u001b[K\r\n  Change password \u270e\u001b[K\r\n\u001b[1;34mUser groups\u001b[0m\u001b[K\r\n  List user groups\u001b[K\r\n  Show user group\u001b[K\r\n  Create user group \u270e\u001b[K\r\n  Edit user group roles \u270e\u001b[K\r\n  Delete user group \u270e\u001b[K\r\n\u001b[1;34mRoles\u001b[0m\u001b[K\r\n  List roles\u001b[K\r\n  Show role\u001b[K\r\n  Create role \u270e\u001b[K\r\n  Edit role privileges \u270e\u001b[K\r\n\u001b[1;34mPrivileges\u001b[0m\u001b[K\r\n\u001b[38;5;244m  1-27 of 49\u001b[0m\u001b[K\r\n\u001b[38;5;252mSet up a new org profile\u001b[0m\u001b[K\r\n\u001b[3;38;5;244m$ iics profile add '<profile name>'\u001b[0m\u001b[K\r\n\u001b[34;H"]
[108.4887, "o", "\u001b[H\u001b[1;36miics\u001b[0m  \u001b[38;5;244mmain menu\u001b[0m   /ag\u001b[7m \u001b[0m\u001b[K\r\n\n\n\n  Edit active profile \u270e\u001b[K\r\n\u001b[1;34mUsers\u001b[0m\u001b[K\r\n  Create user \u270e\u001b[K\r\n\u001b[1;34mEnvironments and agents\u001b[0m\u001b[K\r\n\u001b[1;7m> List runtime environments\u001b[0m\u001b[K\r\n  Create runtime environment \u270e\u001b[K\r\n  List agents\u001b[K\r\n  Show agent details\u001b[K\r\n  Start agent service \u270e\u001b[K\r\n  Stop agent service \u270e\u001b[K\r\n  Restart agent service \u270e\u001b[K\r\n  Edit agent properties \u270e\u001b[K\r\n  Show agent installer info\u001b[K\r\n  Download agent installer\u001b[K\r\n\u001b[1;34mHelp\u001b[0m\u001b[K\r\n  Show CLI help\u001b[K\r\n\u001b[K\r\n\u001b[38;5;252mShow runtime environments (Secure Agent groups)\u001b[0m\u001b[K\r\n\u001b[3;38;5;244m$ iics environment list --profile tst\u001b[0m\u001b[K\r\n\u001b[38;5;244menter run \u00b7 / filter \u00b7 p profile \u00b7 ? help \u00b7 q quit\u001b[0m\u001b[K\u001b[J\u001b[24;H"]
